From: as845320774-lab <306055559+as845320774-lab@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:31:44 +0800
Subject: [PATCH] Default worker sessions to low reasoning effort to cut task
 latency

Worker turns are routine tool work that runs many rounds per ticket, so
paying the deployment default (high) on every round is wasted latency.
DSH's model catalog marks low as 'Prefer for routine or latency-sensitive
tasks'. The orchestrator keeps the deployment default for its
quality-critical assessment; executor.model still overrides the worker.
---
 docs/006-deployment.md    |  2 ++
 src/app/role-models.ts    | 24 ++++++++++++++++++++++--
 src/app/sessions.ts       |  5 +++--
 tests/role-models.spec.ts |  6 ++++++
 4 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/docs/006-deployment.md b/docs/006-deployment.md
index d4e810f..f8fb3a1 100644
--- a/docs/006-deployment.md
+++ b/docs/006-deployment.md
@@ -204,6 +204,8 @@ The blocks:
 - `eval`: `mode`, `timeoutSeconds` and `model`.
 - `executor`: `model`, `maxWorkers`, `directory`, `prepare` and `blockedCommands`. The processing pause is a setting of its own, `paused`, which `POST executor/pause` sets.
 
+A role without a configured `model` uses the profile's default model. The worker is the exception: when `executor.model` is unset, its Session keeps the default route but runs at `low` reasoning effort, because worker turns are routine tool work and DSH's model catalog marks `low` as "Prefer for routine or latency-sensitive tasks". The orchestrator (`eval.model`) keeps the profile default. Set `executor.model` with an explicit `reasoningEffort` to override the worker's default.
+
 Changing a repository or CLI runs the corresponding setup check first. A failed check returns 400 with details in `setup`. A successful account change, or any save while setup is pending, returns `restarting: true`. The API is temporarily unavailable while the application restarts.
 
 ```sh
diff --git a/src/app/role-models.ts b/src/app/role-models.ts
index 5b01e6b..1123746 100644
--- a/src/app/role-models.ts
+++ b/src/app/role-models.ts
@@ -11,10 +11,30 @@ export async function resolveRoleModel(ctx: Context, model: RoleModel): Promise<
   return { provider: value.provider, model: value.model, ...(value.reasoningEffort ? { reasoningEffort: value.reasoningEffort } : {}) }
 }
 
+/**
+ * Reasoning effort a worker Session defaults to when no executor model is configured. Worker turns are routine tool work,
+ * and DSH's model catalog describes `low` as "Prefer for routine or latency-sensitive tasks", so paying the deployment
+ * default (`high`) on every round of a long task is wasted latency. The orchestrator keeps the deployment default for its
+ * quality-critical assessment. Configure `executor.model` to override this default for the worker.
+ */
+export const WORKER_DEFAULT_REASONING_EFFORT = 'low'
+
 /** Seed a role's configured model onto a brand-new session before its first request, leaving later manual or durable selections intact. */
-export async function initializeRoleModel(ctx: Context, agent: Agent, model: RoleModel | null): Promise<void> {
-  if (!model) return
+export async function initializeRoleModel(ctx: Context, agent: Agent, model: RoleModel | null, defaultReasoningEffort?: string): Promise<void> {
   if (agent.session.requestHeader() || agent.session.snapshotEvents().some(event => event.type === 'model/selection')) return
+  if (!model) {
+    // No per-role model: keep the deployment's default route and only tune the reasoning effort for a latency-sensitive role.
+    if (!defaultReasoningEffort) return
+    const effort = ReasoningEffortId(defaultReasoningEffort)
+    agent.ctx.effect(() => {
+      const dispose = agent.ctx.on('agent/request', async (_payload, next) => {
+        const result = await next()
+        return { ...result, reasoningEffort: effort }
+      }, { prepend: true })
+      return () => dispose()
+    })
+    return
+  }
   const selected = await resolveRoleModel(ctx, model)
   // Avoid selectModel because it mutates the global DSH default; inject the selection for the initial request only.
   agent.session.append('model/selection', selected)
